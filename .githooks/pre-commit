#!/usr/bin/env bash
#
# Pre-commit gate: refuse to commit malformed CIDR lists.
#
# Runs utils/validate.py against the ipv4/ipv6 (and _merged) files staged in
# THIS commit. Blocks base64/PGP blocks, bare IPs without a prefix, dig error
# strings — the classes of garbage that have leaked into published lists before.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Bypass in a genuine emergency:  git commit --no-verify
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# Staged (added/copied/modified) CIDR-list files. Keep only those inside a
# provider directory (path contains a "/") — the legacy root-level ipv4.txt /
# ipv6.txt are not used by tooling and are intentionally skipped.
files=()
while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in */*) files+=("$f") ;; esac
done < <(git diff --cached --name-only --diff-filter=ACM -- \
    '*ipv4.txt' '*ipv6.txt' '*ipv4_merged.txt' '*ipv6_merged.txt')

# Nothing relevant staged — let the commit through.
if [ "${#files[@]}" -eq 0 ]; then
    exit 0
fi

# Prefer python3, fall back to python (mise/venv setups expose one or the other).
py="python3"
command -v python3 >/dev/null 2>&1 || py="python"

if ! "$py" "$repo_root/utils/validate.py" --files "${files[@]}"; then
    echo "" >&2
    echo "pre-commit: blocked — the staged IP lists contain invalid CIDRs." >&2
    echo "Fix the offending downloader/output, or bypass with --no-verify." >&2
    exit 1
fi
